<?xml version="1.0" encoding="utf-8"?>
<!-- Panels are often reached by IP over plain HTTP; HTTPS panels with a
     self-signed certificate are handled by the app's certificate pinning. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
