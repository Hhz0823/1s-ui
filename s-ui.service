[Unit]
Description=s-ui Service
Documentation=https://github.com/Hhz0823/1s-ui
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/usr/local/s-ui/
ExecStart=/usr/local/s-ui/sui
Restart=on-failure
RestartSec=10s

# Prefer killing the panel under memory pressure instead of SSH/sshd.
OOMScoreAdjust=800
OOMPolicy=continue

# Soft Go heap cap (override in drop-in). Hard MemoryMax is intentionally avoided —
# it can thrash small VPS into a reboot-like freeze.
Environment=GOMEMLIMIT=400MiB
Environment=GOGC=50
# Default runtime starts sing-box. Low-resource installs disable Xray separately.
Environment=SUI_SKIP_CORE=false

# Do NOT set MemoryMax here.
LimitNOFILE=1048576
TimeoutStartSec=60
TimeoutStopSec=30
Nice=10

[Install]
WantedBy=multi-user.target
