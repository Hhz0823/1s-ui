#!/bin/sh /etc/rc.common
# 1S-UI for OpenWrt: the panel with its sing-box, the controller agent and
# the web UI in one process. Settings that differ from the defaults below go
# in /etc/s-ui/env as KEY=value lines (SUI_API_PORT=2095 …).

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/sui
DATA_DIR=/etc/s-ui
BIN_DIR=/usr/lib/s-ui
WEB_DIR=/usr/share/s-ui/web
RUN_DIR=/var/run/s-ui

# memory_limit keeps Go's heap small on routers: a quarter of the RAM,
# between 48 and 256 MiB. Go treats it as a soft target, never a crash.
memory_limit() {
	total=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)
	[ -n "$total" ] || total=512
	limit=$((total / 4))
	[ "$limit" -lt 48 ] && limit=48
	[ "$limit" -gt 256 ] && limit=256
	echo "${limit}MiB"
}

start_service() {
	mkdir -p "$DATA_DIR/db" "$BIN_DIR" "$RUN_DIR"
	SUI_LOG_LEVEL=warn
	SUI_API_LISTEN=0.0.0.0
	SUI_API_PORT=2095
	GOMEMLIMIT=$(memory_limit)
	[ -f "$DATA_DIR/env" ] && . "$DATA_DIR/env"
	web=""
	[ -f "$WEB_DIR/index.html" ] && web="$WEB_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		SUI_DB_FOLDER="$DATA_DIR/db" \
		SUI_BIN_FOLDER="$BIN_DIR" \
		SUI_LOG_LEVEL="$SUI_LOG_LEVEL" \
		SUI_API_LISTEN="$SUI_API_LISTEN" \
		SUI_API_PORT="$SUI_API_PORT" \
		SUI_CONTROL_SOCKET="$RUN_DIR/control.sock" \
		SUI_AGENT_EMBEDDED=true \
		SUI_AGENT_ENV_FILE="$DATA_DIR/agent.env" \
		SUI_FRONTEND_DIR="$web" \
		GOMEMLIMIT="$GOMEMLIMIT"
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# The proxy client points dnsmasq at itself while it runs; when the panel
# stops, dnsmasq goes back to its own upstream servers at once.
stop_service() {
	changed=""
	for file in /tmp/dnsmasq.d/1s-ui-client.conf /tmp/dnsmasq.cfg*.d/1s-ui-client.conf; do
		[ -f "$file" ] || continue
		rm -f "$file"
		changed=1
	done
	[ -n "$changed" ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1
	return 0
}

reload_service() {
	stop
	start
}
